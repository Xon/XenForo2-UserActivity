{
    "template": "thread_view",
    "description": "Adds activity containers (count)",
    "execution_order": 10,
    "enabled": true,
    "action": "preg_replace",
    "find": "#({\\$thread.title}.*)(</xf:h1>)#si",
    "replace": "$1\n\t<xf:macro name=\"UA_ViewContainer_macros::viewerCounts\"\n\t\t\targ-recordCounts=\"{$UA_RecordCounts}\" \n\t\t\targ-contentType=\"thread\"\n\t\t\targ-contentId=\"{$thread.thread_id}\"\n\t\t\t/>\n$2"
}